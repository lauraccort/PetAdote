<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="480.0" prefWidth="640.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaListarProcessosAdocaoController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <HBox alignment="CENTER_LEFT" spacing="12.0">
      <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagens/abrigo.png" />
         </image>
      </ImageView>
      <Label text="Processos de adoção" textFill="#9c4f2a">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
   </HBox>
   <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-spacing: 16;">
      <children>
         <VBox spacing="8.0">
            <Button onAction="#abrirListarSolicitacoesPendentes" prefWidth="280.0" text="Solicitações pendentes" />
         </VBox>
         <VBox spacing="8.0">
            <children>
               <Button onAction="#abrirFinalizarProcessoAdocao" prefWidth="280.0" text="Finalizar processo de adoção" />
            </children>
         </VBox>
      </children>
   </HBox>
   <!-- espaço vazio que empurra o rodapé para baixo; o conteúdo da tela entra acima -->
   <Region VBox.vgrow="ALWAYS" />
   <Button onAction="#voltar" text="Voltar" />
</VBox>
