<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="560.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaRelatorioProcessosPendentesController">
   <stylesheets>
      <URL value="@petadote.css" />
   </stylesheets>
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
   </padding>
   <top>
      <HBox alignment="CENTER_LEFT" spacing="14.0">
         <BorderPane.margin>
            <Insets bottom="16.0" />
         </BorderPane.margin>
         <children>
            <ImageView fitHeight="56.0" fitWidth="56.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imagens/relatorios.png" />
               </image>
            </ImageView>
            <VBox spacing="2.0">
               <children>
                  <Label text="PetAdote" textFill="#9c4f2a">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Label text="Relatório de processos pendentes " textFill="#4a2a1a" wrapText="true">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <TableView fx:id="tabela" prefHeight="340.0" prefWidth="673.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colProcesso" prefWidth="70.0" text="Processo" />
                  <TableColumn fx:id="colAbertura" prefWidth="90.0" text="Abertura" />
                  <TableColumn fx:id="colDias" prefWidth="100.0" text="Dias pendente" />
                  <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="colParecer" prefWidth="110.0" text="Último parecer" />
                  <TableColumn fx:id="colAnimal" prefWidth="110.0" text="Animal" />
                  <TableColumn fx:id="colEspecie" prefWidth="80.0" />
                  <TableColumn fx:id="colRaca" prefWidth="110.0" text="Raça" />
                  <TableColumn fx:id="colNascimentoAnimal" prefWidth="90.0" text="Nascimento" />
                  <TableColumn fx:id="colAbrigo" prefWidth="130.0" text="Abrigo" />
                  <TableColumn fx:id="colAdotante" prefWidth="140.0" text="Adotante" />
                  <TableColumn fx:id="colCpf" prefWidth="110.0" text="CPF" />
                  <TableColumn fx:id="colEnderecoAdotante" prefWidth="190.0" text="Endereço do adotante" />
                  <TableColumn fx:id="colQuantAnimais" prefWidth="130.0" text="Animais que já possui" />
                  <TableColumn fx:id="colAvaliacoes" prefWidth="80.0" text="Avaliações" />
                  <TableColumn fx:id="colVisitas" prefWidth="130.0" text="Visitas feitas/total" />
               </columns>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label fx:id="total" textFill="#8a6a58" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <BorderPane.margin>
            <Insets top="16.0" />
         </BorderPane.margin>
         <children>
            <Hyperlink onAction="#voltar" text="Voltar" />
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
