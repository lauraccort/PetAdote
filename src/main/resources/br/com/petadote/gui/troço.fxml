<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="480.0" prefWidth="640.0" spacing="12.0" style="-fx-background-color: #f4efe9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaPrincipalAdministradorController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <Label prefHeight="74.0" prefWidth="355.0" style="-fx-font-family: bold;" text="Painel do administrador" textFill="#a17b45">
      <font>
         <Font name="System Bold" size="29.0" />
      </font>
   </Label>
   <HBox alignment="CENTER" prefHeight="171.0" prefWidth="608.0" style="-fx-spacing: 16;" VBox.vgrow="ALWAYS">
      <children>
         <VBox alignment="CENTER" prefHeight="171.0" prefWidth="618.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);" HBox.hgrow="ALWAYS">
            <Button defaultButton="true" onAction="#abrirRelatorios" prefWidth="280.0" style="-fx-background-color: #d9733a; -fx-background-radius: 6; -fx-cursor: hand;" text="Relatórios" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </VBox>
         <VBox alignment="CENTER" prefHeight="171.0" prefWidth="618.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);" HBox.hgrow="ALWAYS">
            <children>
               <Button onAction="#abrirListarAbrigos" prefWidth="280.0" style="-fx-cursor: hand; -fx-background-color: #d9733a; -fx-background-radius: 6;" text="Abrigos" textFill="WHITE">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
               </Button>
            </children>
         </VBox>
      </children>
   </HBox>
   <!-- espaço vazio que empurra o rodapé para baixo; o conteúdo da tela entra acima -->
   <Region VBox.vgrow="ALWAYS" />
   <Button onAction="#sair" text="Sair" />
</VBox>
