<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="720.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaCadastroController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <Label alignment="CENTER" prefHeight="0.0" prefWidth="660.0" text="Cadastro" textFill="#d9733a">
      <font>
         <Font name="System Bold" size="36.0" />
      </font>
   </Label>
   <VBox prefHeight="442.0" prefWidth="688.0">
      <children>
         <ComboBox prefHeight="26.0" prefWidth="222.0" promptText="Tipo de perfil" />
      </children>
   </VBox>
   <Button alignment="BASELINE_LEFT" onAction="#voltar" prefHeight="10.0" text="Voltar" />
</VBox>
