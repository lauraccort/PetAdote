<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="720.0" spacing="10.0" stylesheets="@petadote.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaListarAdotantesController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <HBox alignment="CENTER_LEFT" spacing="12.0">
      <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagens/abrigo.png" />
         </image>
      </ImageView>
      <Label text="Adotantes" textFill="#9c4f2a">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
   </HBox>

   <Label text="Adotantes cadastrados — selecione um para ver o histórico" textFill="#8a6a58">
      <font>
         <Font name="System Bold" size="13.0" />
      </font>
   </Label>
   <TableView fx:id="tabelaAdotantes" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colunaId" prefWidth="60.0" text="Id" />
         <TableColumn fx:id="colunaNome" prefWidth="220.0" text="Nome" />
         <TableColumn fx:id="colunaEmail" prefWidth="220.0" text="E-mail" />
         <TableColumn fx:id="colunaCpf" prefWidth="160.0" text="CPF" />
      </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
      <placeholder>
         <Label text="Nenhum adotante cadastrado." />
      </placeholder>
   </TableView>
   <Label fx:id="mensagem" textFill="#c0392b" wrapText="true" />

   <HBox alignment="CENTER_LEFT" spacing="8.0">
      <Button onAction="#voltar" text="Voltar" />
      <Region HBox.hgrow="ALWAYS" />
      <Button onAction="#abrirHistoricoAdotante" text="Histórico do adotante" />
   </HBox>
</VBox>
