<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="720.0" spacing="12.0" stylesheets="@petadote.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaAgendarVisitaController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <HBox alignment="CENTER_LEFT" spacing="12.0">
      <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagens/petadote.png" />
         </image>
      </ImageView>
      <Label text="Agendar visita" textFill="#9c4f2a">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
   </HBox>

   <!-- espaços que mantêm o cartão no meio da tela -->
   <Region VBox.vgrow="ALWAYS" />
   <HBox alignment="CENTER">
      <VBox alignment="CENTER" maxWidth="400.0" prefWidth="400.0" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">
         <padding>
            <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
         </padding>
         <Label alignment="CENTER" text="Selecione o dia ideal para sua visita de acompanhamento" textAlignment="CENTER" textFill="#8a6a58" wrapText="true">
            <font>
               <Font name="System Bold" size="13.0" />
            </font>
         </Label>
         <DatePicker fx:id="campoData" prefWidth="220.0" promptText="dd/mm/aaaa" />
         <Label fx:id="mensagem" alignment="CENTER" text="É preciso de duas visitas em um período de 90 dias" textAlignment="CENTER" textFill="#8a6a58" wrapText="true" />
         <Button mnemonicParsing="false" onAction="#agendar" style="-fx-background-radius: 6; -fx-cursor: hand;" text="Agendar visita" textFill="WHITE">
            <font>
               <Font name="System Bold" size="13.0" />
            </font>
            <padding>
               <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
            </padding>
         </Button>
      </VBox>
   </HBox>
   <Region VBox.vgrow="ALWAYS" />

   <Button onAction="#voltar" text="Voltar" />
</VBox>
