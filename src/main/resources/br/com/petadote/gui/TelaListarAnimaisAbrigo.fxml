<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="720.0" spacing="12.0" style="-fx-background-color: #f7efe6;" stylesheets="@petadote.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaListarAnimaisAbrigoController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <HBox alignment="CENTER_LEFT" spacing="12.0">
      <children>
         <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../imagens/abrigo.png" />
            </image>
         </ImageView>
         <VBox spacing="2.0">
            <children>
               <Label text="Animais do abrigo" textFill="#9c4f2a">
                  <font>
                     <Font name="System Bold" size="26.0" />
                  </font>
               </Label>
               <Label text="Selecione um abrigo para ver os animais" textFill="#8a6a58" />
            </children>
         </VBox>
      </children>
   </HBox>

   <VBox spacing="10.0" style="-fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4); -fx-background-color: white;" VBox.vgrow="ALWAYS">
      <padding>
         <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
      </padding>
      <children>
         <!-- Filtros -->
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
               <ComboBox fx:id="filtroAbrigo" prefWidth="220.0" promptText="Abrigo" />
               <ComboBox fx:id="filtroEspecie" prefWidth="130.0" promptText="Espécie" />
               <ComboBox fx:id="filtroStatus" prefWidth="170.0" promptText="Status" />
               <Region HBox.hgrow="ALWAYS" />
               <Button mnemonicParsing="false" onAction="#limparFiltros" prefWidth="90.0" styleClass="botao-secundario" text="Limpar" />
            </children>
         </HBox>
         <TextField fx:id="campoBusca" promptText="Buscar por nome do animal..." />

         <TableView fx:id="tabelaAnimais" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colunaId" prefWidth="50.0" text="ID" />
               <TableColumn fx:id="colunaNome" prefWidth="150.0" text="Nome" />
               <TableColumn fx:id="colunaEspecie" prefWidth="90.0" text="Espécie" />
               <TableColumn fx:id="colunaRaca" prefWidth="130.0" text="Raça" />
               <TableColumn fx:id="colunaIdade" prefWidth="80.0" text="Idade" />
               <TableColumn fx:id="colunaStatus" prefWidth="140.0" text="Status" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
               <Label text="Nenhum animal encontrado." />
            </placeholder>
         </TableView>
         <Label fx:id="mensagem" textFill="#c0392b" wrapText="true" />

         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
               <Button mnemonicParsing="false" onAction="#abrirCadastroAnimal" style="-fx-background-color: #9c4f2a; -fx-background-radius: 6; -fx-cursor: hand;" text="Novo animal" textFill="WHITE">
                  <font>
                     <Font name="System Bold" size="13.0" />
                  </font>
                  <padding>
                     <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
                  </padding>
               </Button>
               <Button mnemonicParsing="false" onAction="#verDetalhes" styleClass="botao-secundario" text="Ver detalhes">
                  <padding>
                     <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
                  </padding>
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
               <Region HBox.hgrow="ALWAYS" />
               <Button onAction="#voltar" text="Voltar" />
            </children>
         </HBox>
      </children>
   </VBox>
</VBox>
