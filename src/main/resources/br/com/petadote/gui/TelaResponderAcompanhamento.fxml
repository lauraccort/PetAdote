<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.petadote.gui.TelaResponderAcompanhamentoController"
      spacing="10" prefWidth="820" prefHeight="640">
   <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

   <Label text="Responder acompanhamento" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
   <Label text="Conte como o animal está se adaptando. O abrigo verá a sua resposta."
          style="-fx-text-fill: #555;"/>

   <Label text="Processo de adoção:"/>
   <ComboBox fx:id="campoProcesso" maxWidth="Infinity" promptText="Selecione o processo"/>

   <Label text="Sua resposta:"/>
   <TextArea fx:id="campoResposta" prefRowCount="5" wrapText="true"
             promptText="Ex.: o animal está se adaptando bem, comendo normalmente..."/>

   <HBox spacing="10" alignment="CENTER_LEFT">
      <Label fx:id="contador" text="0/1000" style="-fx-text-fill: #777;"/>
      <Button fx:id="botaoEnviar" text="Enviar resposta" onAction="#enviar" defaultButton="true"/>
   </HBox>

   <Label fx:id="mensagem" wrapText="true"/>

   <Label text="Respostas já enviadas:" style="-fx-font-weight: bold;"/>
   <TableView fx:id="tabelaRespostas" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colunaTexto" text="Data e resposta" prefWidth="740"/>
      </columns>
   </TableView>

   <HBox spacing="10">
      <Button text="Voltar" onAction="#voltar"/>
   </HBox>
</VBox>