<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="560.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.petadote.gui.TelaResponderAcompanhamentoController">
   <stylesheets>
      <URL value="@petadote.css" />
   </stylesheets>
   <children>
      <VBox maxHeight="-Infinity" maxWidth="520.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">
         <padding>
            <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
         </padding>
         <children>
            <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imagens/petadote.png" />
               </image>
            </ImageView>
            <Label text="PetAdote" textFill="#9c4f2a">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Label text="Responder acompanhamento" textFill="#8a6a58" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Label text="Como o animal está se adaptando?" textFill="#4a2a1a">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <TextArea fx:id="campoResposta" prefHeight="180.0" promptText="Conte como ele está, se está comendo bem, se já se acostumou com a casa..." wrapText="true" />
            <Hyperlink onAction="#voltar" text="Voltar" />
         </children>
      </VBox>
   </children>
</StackPane>
