<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #f4efe9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaFinalizarProcessoAdocaoController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="660.0" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">
         <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
         </padding>
         <children>
            <Label text="Finalizar Processo de Adoção" textFill="#d9733a">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Label text="Confirme os dados e conclua o processo de adoção" textFill="#7a716a">
               <VBox.margin>
                  <Insets bottom="6.0" />
               </VBox.margin>
            </Label>

            <VBox spacing="6.0">
               <children>
                  <Label text="ID do Processo" textFill="#4a2a1a">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="campoIdProcesso" promptText="Digite ou verifique o ID do processo" />

                  <Label text="Observações / Parecer Final" textFill="#4a2a1a">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="4.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="campoObservacoes" promptText="Insira considerações sobre a conclusão" />
               </children>
            </VBox>

            <Label fx:id="mensagem" textFill="#c0392b" wrapText="true" />

            <Button fx:id="btnAcompanharPosAdocao" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirAcompanharPosAdocao" style="-fx-background-color: #d9733a; -fx-background-radius: 6; -fx-cursor: hand;" text="Acompanhamento pós-adoção" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </Button>

            <Button maxWidth="1.7976931348623157E308" onAction="#voltar" text="Voltar">
               <padding>
                  <Insets bottom="8.0" top="8.0" />
               </padding>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>