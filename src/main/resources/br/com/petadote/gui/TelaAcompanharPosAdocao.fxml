<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.petadote.gui.TelaAcompanharPosAdocaoController"
      spacing="10" prefWidth="1000" prefHeight="720">
   <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

   <Label text="Acompanhamento pós-adoção" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

   <TableView fx:id="tabelaProcessos" prefHeight="180">
      <columns>
         <TableColumn fx:id="colunaProcessoId" text="Processo" prefWidth="80"/>
         <TableColumn fx:id="colunaAnimal" text="Animal" prefWidth="150"/>
         <TableColumn fx:id="colunaAdotante" text="Adotante" prefWidth="170"/>
         <TableColumn fx:id="colunaStatus" text="Status" prefWidth="120"/>
         <TableColumn fx:id="colunaVisitasPeriodo" text="Visitas em 90 dias" prefWidth="150"/>
      </columns>
   </TableView>

   <Label fx:id="tituloVisitas" text="Visitas do processo selecionado"
          style="-fx-font-weight: bold;"/>

   <TableView fx:id="tabelaVisitas" prefHeight="150">
      <columns>
         <TableColumn fx:id="colunaData" text="Data" prefWidth="100"/>
         <TableColumn fx:id="colunaRealizada" text="Realizada" prefWidth="90"/>
         <TableColumn fx:id="colunaSituacao" text="Situação do animal" prefWidth="180"/>
         <TableColumn fx:id="colunaObservacoes" text="Observações" prefWidth="300"/>
      </columns>
   </TableView>

   <HBox spacing="10" alignment="CENTER_LEFT">
      <Label text="Nova visita:"/>
      <DatePicker fx:id="campoDataVisita" promptText="dd/MM/aaaa"/>
      <Button fx:id="botaoAgendar" text="Agendar visita" onAction="#agendarVisita"/>
      <Label fx:id="situacaoMinimo" wrapText="true"/>
   </HBox>

   <Label text="Respostas do adotante:" style="-fx-font-weight: bold;"/>
   <TextArea fx:id="campoRespostasAdotante" prefRowCount="4" wrapText="true"
             editable="false" VBox.vgrow="ALWAYS"/>

   <Label fx:id="mensagem" wrapText="true"/>

   <HBox spacing="10">
      <Button text="Listar visitas" onAction="#abrirListarVisitas"/>
      <Button text="Principal do abrigo" onAction="#abrirPrincipalAbrigo"/>
      <Button text="Voltar" onAction="#voltar"/>
   </HBox>
</VBox>