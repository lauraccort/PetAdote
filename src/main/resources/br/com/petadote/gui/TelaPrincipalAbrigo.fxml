<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Mesma paleta da TelaLogin: fundo #f4efe9, laranja #d9733a, cinza #7a716a -->
<BorderPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #f4efe9;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.petadote.gui.TelaPrincipalAbrigoController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #d9733a;">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <Label text="PetAdote" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label text="Painel do Abrigo" textFill="#fbe3d3">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>

   <center>
      <VBox spacing="16.0">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
         </padding>
         <children>
            <Label text="O que você quer fazer?" textFill="#3d3733">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>

            <!-- 2 colunas x 2 linhas; cada botão preenche a célula inteira -->
            <GridPane hgap="16.0" vgap="16.0" VBox.vgrow="ALWAYS">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints vgrow="ALWAYS" percentHeight="50.0" />
                  <RowConstraints vgrow="ALWAYS" percentHeight="50.0" />
               </rowConstraints>
               <children>
                  <Button GridPane.columnIndex="0" GridPane.rowIndex="0"
                          maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                          onAction="#abrirListarAnimaisAbrigo" text="Animais do abrigo"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 3);"
                          textFill="#3d3733">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Button>
                  <Button GridPane.columnIndex="1" GridPane.rowIndex="0"
                          maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                          onAction="#abrirListarAdotantes" text="Adotantes"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 3);"
                          textFill="#3d3733">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Button>
                  <Button GridPane.columnIndex="0" GridPane.rowIndex="1"
                          maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                          onAction="#abrirListarProcessosAdocao" text="Processos de adoção"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 3);"
                          textFill="#3d3733">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Button>
                  <Button GridPane.columnIndex="1" GridPane.rowIndex="1"
                          maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                          onAction="#abrirListarVisitas" text="Visitas"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 12, 0, 0, 3);"
                          textFill="#3d3733">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Button>
               </children>
            </GridPane>
         </children>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER_RIGHT">
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="0.0" />
         </padding>
         <children>
            <Button onAction="#sair" text="Sair"
                    style="-fx-background-color: transparent; -fx-border-color: #d9733a; -fx-border-radius: 6; -fx-text-fill: #d9733a; -fx-cursor: hand;">
               <padding>
                  <Insets bottom="6.0" left="20.0" right="20.0" top="6.0" />
               </padding>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>

