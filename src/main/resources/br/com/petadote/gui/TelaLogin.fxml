<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #f4efe9;"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.petadote.gui.TelaLoginController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="340.0" spacing="8.0"
            style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">
         <padding>
            <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
         </padding>
         <children>
            <Label text="PetAdote" textFill="#d9733a">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Label text="Entre na sua conta para continuar" textFill="#7a716a">
               <VBox.margin>
                  <Insets bottom="12.0" />
               </VBox.margin>
            </Label>

            <Label text="E-mail" />
            <TextField fx:id="campoEmail" promptText="seu@email.com" />

            <Label text="Senha">
               <VBox.margin>
                  <Insets top="4.0" />
               </VBox.margin>
            </Label>
            <PasswordField fx:id="campoSenha" promptText="Digite sua senha" />

            <Label text="Entrar como">
               <VBox.margin>
                  <Insets top="4.0" />
               </VBox.margin>
            </Label>
            <ComboBox fx:id="campoPerfil" maxWidth="1.7976931348623157E308" />

            <Label fx:id="mensagem" textFill="#c0392b" wrapText="true" />

            <Button defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#entrar"
                    style="-fx-background-color: #d9733a; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Entrar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="8.0" top="8.0" />
               </padding>
            </Button>

            <Hyperlink onAction="#abrirCadastro" text="Não tem conta? Cadastre-se" />
         </children>
      </VBox>
   </children>
</StackPane>
