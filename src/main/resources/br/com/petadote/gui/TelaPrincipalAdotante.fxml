<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #f7efe6;"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.com.petadote.gui.TelaPrincipalAdotanteController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="340.0" spacing="8.0"
            style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">
         <padding>
            <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
         </padding>
         <children>
            <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imagens/petadote.png" />
               </image>
            </ImageView>
            <Label text="PetAdote" textFill="#9c4f2a">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Label text="Painel do adotante" textFill="#8a6a58">
               <VBox.margin>
                  <Insets bottom="12.0" />
               </VBox.margin>
            </Label>

            <Button maxWidth="1.7976931348623157E308" onAction="#abrirListarAnimaisDisponiveis"
                    style="-fx-background-color: #9c4f2a; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Animais disponíveis" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="8.0" top="8.0" />
               </padding>
            </Button>
            <Button maxWidth="1.7976931348623157E308" onAction="#abrirListarMeusProcessos"
                    style="-fx-background-color: #9c4f2a; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Meus processos" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="8.0" top="8.0" />
               </padding>
            </Button>
            <Button maxWidth="1.7976931348623157E308" onAction="#abrirListarMinhasVisitas"
                    style="-fx-background-color: #9c4f2a; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Minhas visitas" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="8.0" top="8.0" />
               </padding>
            </Button>
            <Button maxWidth="1.7976931348623157E308" onAction="#abrirResponderAcompanhamento"
                    style="-fx-background-color: #9c4f2a; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Responder acompanhamento" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="8.0" top="8.0" />
               </padding>
            </Button>

            <Hyperlink onAction="#sair" text="Sair" />
         </children>
      </VBox>
   </children>
</StackPane>