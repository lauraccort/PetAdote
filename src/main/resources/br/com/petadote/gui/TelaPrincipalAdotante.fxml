<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="480.0" prefWidth="640.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaPrincipalAdotanteController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <Label text="Principal - Adotante">
      <font>
         <Font size="20.0" />
      </font>
   </Label>
   <VBox spacing="8.0">
      <Button onAction="#abrirListarAnimaisDisponiveis" prefWidth="280.0" text="Animais disponíveis" />
      <Button onAction="#abrirListarMeusProcessos" prefWidth="280.0" text="Meus processos" />
      <Button onAction="#abrirListarMinhasVisitas" prefWidth="280.0" text="Minhas visitas" />
      <Button onAction="#abrirResponderAcompanhamento" prefWidth="280.0" text="Responder acompanhamento" />
   </VBox>
   <!-- espaço vazio que empurra o rodapé para baixo; o conteúdo da tela entra acima -->
   <Region prefHeight="240.0" prefWidth="608.0" VBox.vgrow="ALWAYS" />
   <Button onAction="#sair" text="Sair" />
</VBox>
