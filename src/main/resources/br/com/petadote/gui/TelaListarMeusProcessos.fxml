<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #f7efe6;" stylesheets="@petadote.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaListarMeusProcessosController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="660.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">
         <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../imagens/petadote.png" />
                     </image>
                  </ImageView>
                  <Label text="Meus Processos" textFill="#9c4f2a">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Label text="Acompanhe o andamento dos seus pedidos de adoção" textFill="#8a6a58">
               <VBox.margin>
                  <Insets bottom="4.0" />
               </VBox.margin>
            </Label>

            <TableView fx:id="tabelaMeusProcessos" prefHeight="230.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colunaId" prefWidth="65.0" style="-fx-font-weight: bold;" text="ID" />
                  <TableColumn fx:id="colunaAnimal" prefWidth="200.0" style="-fx-font-weight: bold;" text="Animal" />
                  <TableColumn fx:id="colunaData" prefWidth="175.0" style="-fx-font-weight: bold;" text="Data" />
                  <TableColumn fx:id="colunaStatus" prefWidth="160.0" style="-fx-font-weight: bold;" text="Status" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <placeholder>
                  <Label text="Você ainda não pediu nenhuma adoção." />
               </placeholder>
            </TableView>

            <Label fx:id="mensagem" textFill="#c0392b" wrapText="true" />

            <Button fx:id="btnParecer" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirConsultarParecer" style="-fx-background-color: #9c4f2a; -fx-background-radius: 6; -fx-cursor: hand;" text="Consultar Parecer" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
               <padding>
                  <Insets bottom="8.0" top="8.0" />
               </padding>
            </Button>

            <Button maxWidth="1.7976931348623157E308" onAction="#voltar" text="Voltar">
               <padding>
                  <Insets bottom="6.0" top="6.0" />
               </padding>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
