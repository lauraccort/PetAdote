<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #f7efe6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaRelatoriosController">
   <stylesheets>
      <URL value="@petadote.css" />
   </stylesheets>
   <children>
      <VBox alignment="CENTER" maxHeight="450.0" maxWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4); -fx-background-radius: 8;">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>
            <ImageView fitHeight="72.0" fitWidth="72.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../imagens/relatorios.png" />
               </image>
            </ImageView>

            <VBox alignment="CENTER" spacing="2.0">
               <children>
                  <Label text="PetAdote" textFill="#9c4f2a">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="Relatórios" textFill="#8a6a58" wrapText="true">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <Region prefHeight="15.0" />

            <Button maxWidth="1.7976931348623157E308" onAction="#abrirRelatorioAnimaisDisponiveis" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 14 10 14;" text="Relatório de animais disponíveis" textAlignment="CENTER" wrapText="true" />
            <Button maxWidth="1.7976931348623157E308" onAction="#abrirRelatorioAdocoesConcluidas" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 14 10 14;" text="Relatório de adoções concluídas" textAlignment="CENTER" wrapText="true" />
            <Button maxWidth="1.7976931348623157E308" onAction="#abrirRelatorioProcessosPendentes" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 14 10 14;" text="Relatório de processos pendentes" textAlignment="CENTER" wrapText="true" />

            <Region prefHeight="15.0" />

            <Hyperlink onAction="#voltar" text="Voltar" />
         </children>
      </VBox>
   </children>
</StackPane>
