<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #f4efe9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaHistoricoAdotanteController">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="660.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">
         <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
         </padding>
         <children>
            <Label text="Histórico do Adotante" textFill="#d9733a">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Label text="Acompanhe o histórico de solicitações e processos" textFill="#7a716a">
               <VBox.margin>
                  <Insets bottom="4.0" />
               </VBox.margin>
            </Label>

            <TableView fx:id="tabelaHistorico" prefHeight="300.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colunaId" prefWidth="65.0" style="-fx-font-weight: bold;" text="ID" />
                  <TableColumn fx:id="colunaProcesso" prefWidth="230.0" style="-fx-font-weight: bold;" text="Processo / Detalhe" />
                  <TableColumn fx:id="colunaStatus" prefWidth="140.0" style="-fx-font-weight: bold;" text="Status" />
                  <TableColumn fx:id="colunaData" prefWidth="165.0" style="-fx-font-weight: bold;" text="Data" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <Label fx:id="mensagem" textFill="#c0392b" wrapText="true" />

            <Button mnemonicParsing="false" onAction="#abrirListarSolicitacoesPendentes" maxWidth="1.7976931348623157E308" style="-fx-background-color: #d9733a; -fx-background-radius: 6; -fx-cursor: hand;" text="Solicitações pendentes" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
               <padding>
                  <Insets bottom="8.0" top="8.0" />
               </padding>
            </Button>

            <Button maxWidth="1.7976931348623157E308" onAction="#voltar" text="Voltar">
               <padding>
                  <Insets bottom="6.0" top="6.0" />
               </padding>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>