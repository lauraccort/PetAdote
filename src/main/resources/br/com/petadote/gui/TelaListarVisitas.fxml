<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #f7efe6;" stylesheets="@petadote.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.petadote.gui.TelaListarVisitasController">

   <padding>
      <Insets bottom="28.0" left="24.0" right="28.0" top="24.0" />
   </padding>

   <!-- TOPO: Cabeçalho com Ícone e Títulos -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="14.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="16.0" />
         </BorderPane.margin>
         <children>
            <ImageView fitHeight="56.0" fitWidth="56.0" preserveRatio="true">
               <image>
                  <Image url="@../imagens/abrigo.png" />
               </image>
            </ImageView>
            <VBox alignment="CENTER_LEFT" spacing="2.0">
               <children>
                  <Label text="PetAdote" textFill="#9c4f2a">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Label text="Painel de Visitas" textFill="#4a2a1a" wrapText="true">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>
   </top>

   <!-- CENTRO: Área de conteúdo (Tabela) -->
   <center>
      <VBox spacing="10.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12;" BorderPane.alignment="CENTER">
         <effect>
            <DropShadow height="15.0" radius="7.0" width="15.0">
               <color>
                  <Color opacity="0.1" />
               </color>
            </DropShadow>
         </effect>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label text="Agendamentos de Visita" textFill="#4a2a1a">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Label>

            <TableView fx:id="tabelaVisitas" prefHeight="350.0" prefWidth="600.0" style="-fx-border-color: #e6e6e6; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colunaNumero" prefWidth="45.0" text="Nº" />
                  <TableColumn fx:id="colunaDataHora" prefWidth="120.0" text="Data / Hora" />
                  <TableColumn fx:id="colunaAnimal" prefWidth="150.0" text="Animal" />
                  <TableColumn fx:id="colunaAdotante" prefWidth="150.0" text="Adotante" />
                  <TableColumn fx:id="colunaStatus" prefWidth="100.0" text="Status" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <placeholder>
                  <Label text="Não há visitas agendadas no momento." textFill="#8a6a58" />
               </placeholder>
            </TableView>
            <Label fx:id="mensagem" textFill="#c0392b" wrapText="true" />
         </children>
      </VBox>
   </center>

   <!-- BASE: Rodapé com link Voltar e Botões de Ação -->
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="16.0" />
         </BorderPane.margin>
         <children>
            <Hyperlink onAction="#voltar" style="-fx-text-fill: #9c4f2a;" text="Voltar">
               <font>
                  <Font size="14.0" />
               </font>
            </Hyperlink>

            <!-- Empurra os botões para a direita -->
            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#abrirAvaliarVisita" style="-fx-background-color: #9c4f2a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Avaliar visita">
               <padding>
                  <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
               </padding>
            </Button>

            <Button onAction="#abrirConfirmarAgendamentoVisita" style="-fx-background-color: #9c4f2a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Confirmar agendamento">
               <padding>
                  <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
               </padding>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>